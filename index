<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INK A HOUSE | Revolución de Vivienda Juvenil</title>

    <link href="https://fonts.googleapis.com/css2?family=Paytone+One&family=Inter:wght@400;700;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --yellow: #FCD53F;
            --navy: #1A3A5A;
            --white: #ffffff;
            --bg-light: #F9F9F9;
            --transition: all 0.3s ease;
        }

        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            color: var(--navy);
            background-color: var(--white);
        }

        h1, h2, h3 {
            font-family: 'Paytone One', sans-serif;
            text-transform: uppercase;
        }

        nav {
            background-color: var(--navy);
            padding: 15px 5%;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .nav-links a {
            color: var(--white);
            text-decoration: none;
            margin-left: 20px;
            font-weight: 700;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--yellow);
        }

        .btn-nav {
            background-color: var(--yellow);
            color: var(--navy) !important;
            padding: 8px 15px;
            border-radius: 5px;
        }

        .hero {
            background-color: var(--yellow);
            padding: 100px 5%;
            text-align: center;
            clip-path: polygon(0 0, 100% 0, 100% 90%, 0% 100%);
            border-bottom: 8px solid var(--navy);
        }

        .hero h1 {
            font-size: 4rem;
            margin: 0;
            line-height: 1;
            text-shadow: 3px 3px 0px var(--white);
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 20px auto;
            font-weight: 700;
        }

        section {
            padding: 100px 10%;
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 50px;
            position: relative;
        }

        .section-title::after {
            content: '';
            width: 80px;
            height: 8px;
            background: var(--yellow);
            display: block;
            margin: 10px auto;
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .card {
            padding: 40px;
            border: 4px solid var(--navy);
            border-radius: 20px;
            background: var(--white);
            transition: var(--transition);
            position: relative;
        }

        .card:hover {
            transform: rotate(-2deg) translateY(-10px);
            box-shadow: 10px 10px 0px var(--yellow);
        }

        .origins-box {
            background: var(--navy);
            color: var(--white);
            padding: 60px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .project-item {
            display: flex;
            gap: 30px;
            background: var(--bg-light);
            margin-bottom: 30px;
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid #eee;
        }

        .project-img {
            width: 40%;
            background: #ddd;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .project-info { padding: 30px; width: 60%; }

        footer {
            background: var(--navy);
            color: var(--white);
            padding: 80px 10% 40px;
            text-align: center;
        }

        .social-btn {
            display: inline-block;
            background: var(--yellow);
            color: var(--navy);
            padding: 15px 40px;
            border-radius: 50px;
            font-weight: 900;
            text-decoration: none;
            margin-top: 20px;
            font-size: 1.2rem;
            transition: var(--transition);
        }

        .social-btn:hover {
            transform: scale(1.1);
            background: var(--white);
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            .origins-box { flex-direction: column; padding: 30px; }
            .project-item { flex-direction: column; }
            .project-img, .project-info { width: 100%; }
        }
    </style>
</head>
<body>
    <h1>Tu web ya está lista 🚀</h1>
</body>
</html>
